# VITE_API_BASE_URL
# -----------------
# Set this in Vercel (Project Settings → Environment Variables) to the base URL
# of your deployed Rails API, including the path prefix.
#
# Examples:
#   VITE_API_BASE_URL=https://api.example.com/api/v1
#   VITE_API_BASE_URL=https://beachvolleyball-api.up.railway.app/api/v1
#
# When unset, defaults to "/api/v1" (Vite dev proxy for local development).
# VITE_API_BASE_URL=

# VITE_GOOGLE_MAPS_EMBED_API_KEY
# --------------------------------
# Public browser key used only by the Google Maps Embed API. Restrict the key
# to that API and to approved HTTP referrers. For local development include:
#   http://localhost:5174/*
# Do not use a privileged server-side Google API key here; all VITE_* values
# are included in the browser bundle.
# VITE_GOOGLE_MAPS_EMBED_API_KEY=
# VITE_TURNSTILE_SITE_KEY
# -----------------------
# Public Cloudflare Turnstile site key for the Contact form (IDENTITY-259).
# Safe to expose: it identifies the widget, it does not verify anything. The
# matching TURNSTILE_SECRET_KEY belongs on the Rails API only — never here.
# When empty the widget is not rendered and the API decides (production fails
# closed), so set it for any deployed environment.
#   Create/reuse the widget at https://dash.cloudflare.com -> Turnstile and add
#   beachvolleyballhub.com (plus any staging hostnames).
# VITE_TURNSTILE_SITE_KEY=

# Feature flags
VITE_MOBILE_LAYOUT_ENABLED=true
VITE_PWA_ENABLED=true
VITE_OFFLINE_ENABLED=true