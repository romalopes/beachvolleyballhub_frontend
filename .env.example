# VITE_API_BASE_URL
# -----------------
# Set this in Vercel (Project Settings → Environment Variables) to the base URL
# of your deployed Rails API, including the path prefix.
#
# Examples:
#   VITE_API_BASE_URL=https://api.example.com/api/v1
#   VITE_API_BASE_URL=https://beachvolleyball-api.up.railway.app/api/v1
#
# When unset, defaults to "/api/v1" (Vite dev proxy for local development).
# VITE_API_BASE_URL=

# VITE_GOOGLE_MAPS_EMBED_API_KEY
# --------------------------------
# Public browser key used only by the Google Maps Embed API. Restrict the key
# to that API and to approved HTTP referrers. For local development include:
#   http://localhost:5174/*
# Do not use a privileged server-side Google API key here; all VITE_* values
# are included in the browser bundle.
# VITE_GOOGLE_MAPS_EMBED_API_KEY=